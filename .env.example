# Generate with: incidentpilot generate-secret
INCIDENTPILOT_AUTH_SECRET=

# Generate each record with: incidentpilot create-user USERNAME --role ROLE
# Merge records into one JSON object; do not commit the populated value.
INCIDENTPILOT_USERS_JSON={}

INCIDENTPILOT_TOKEN_TTL_SECONDS=900
INCIDENTPILOT_DB_PATH=data/incidentpilot.db
INCIDENTPILOT_RUNBOOK_PATH=data/runbooks.db
